# AI 提供商：qwen / gemini / zhipu / groq / openai / deepseek
AI_PROVIDER=qwen

# API Key（必填）
AI_API_KEY=your-api-key-here

# API Base URL（可选，留空则使用提供商默认值）
AI_API_BASE=

# 模型名称（可选，留空则使用提供商默认模型）
AI_MODEL=Qwen/Qwen3-8B

# 翻译功能开关
AI_TRANSLATE_ENABLED=true

# HTTP代理（用于访问国外RSS源）
# 留空则不使用代理
HTTP_PROXY=http://127.0.0.1:7890
